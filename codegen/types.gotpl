{{- define "generateStruct" -}}
type {{ typeName . }} struct {
{{ range $field := typeFields . -}}
    {{ go $field.Name.String }} {{ $field.Type.GoTypeRepr }} {{ printf "`json:%q`" $field.Name.String }}
{{ end -}}
}
{{- end -}}
{{- define "generateEnum" -}}
{{ $enumName := typeName . }}
type {{ $enumName }} string

const (
{{ range $variant := .Variants -}}
    {{- printf "%v%v " $enumName (go $variant.String)  -}}
    {{- $enumName -}} = {{- printf " %q\n" $variant.String -}}
{{ end -}}
)
{{- end -}}
